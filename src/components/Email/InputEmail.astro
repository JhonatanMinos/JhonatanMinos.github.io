---
import { email } from "../../data/site.js";
---

<div id="contact" class="mt-8 mb-8 scroll-mt-20">
  <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">Email</h2>
  <div class="relative">
    <div
      class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none"
    >
      <svg
        class="w-5 h-5 text-gray-800 dark:text-white"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
        ></path>
      </svg>
    </div>
    <a
      href={`mailto:${email}`}
      id="email"
      class="block w-full p-4 ps-10 pe-24 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:bg-gray-600 truncate"
    >
      {email}
    </a>
    <button
      type="button"
      data-copy-email
      class="text-white absolute end-2.5 bottom-2.5 bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-semibold rounded-lg text-sm px-4 py-2 transition-colors duration-200 dark:hover:bg-blue-500 dark:focus:ring-blue-800"
    >
      <span data-copy-label>Copy</span>
    </button>
  </div>
</div>

<script>
  const button = document.querySelector("[data-copy-email]");
  const link = document.getElementById("email");

  if (button && link) {
    const label = button.querySelector("[data-copy-label]");
    let resetTimer;

    button.addEventListener("click", async () => {
      const address = link.textContent.trim();

      try {
        await navigator.clipboard.writeText(address);
      } catch {
        // Fallback for insecure contexts (non-HTTPS / clipboard blocked).
        const area = document.createElement("textarea");
        area.value = address;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.appendChild(area);
        area.select();
        document.execCommand("copy");
        document.body.removeChild(area);
      }

      label.textContent = "Copied!";
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        label.textContent = "Copy";
      }, 1500);
    });
  }
</script>
